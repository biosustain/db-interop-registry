# Connection Mode (azure or local)
CONNECTION_MODE=azure

# Azure Database Configuration
DB_HOST=your-server.postgres.database.azure.com
DB_NAME=interopdb
DB_USERNAME=interopadmin

# Azure Key Vault Configuration
KEYVAULT_NAME=your-keyvault-name
KEYVAULT_SECRET_NAME=DBPASS

# Local Database Configuration (for CONNECTION_MODE=local)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=interopdb
LOCAL_DB_USERNAME=app_user
LOCAL_DB_PASSWORD=app_password